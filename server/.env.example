# scripts/bootstrap.py creates .env with generated secrets. Never commit .env.
LAN_IP=192.168.0.64
HTTPS_PORT=443
PORT=3000
PUBLIC_ORIGIN=https://192.168.0.64
LIVEKIT_PUBLIC_URL=wss://192.168.0.64/livekit
LIVEKIT_URL=http://livekit:7880
LIVEKIT_API_KEY=think-meet-local
LIVEKIT_API_SECRET=generated-by-bootstrap
PROXY_AUTH_SECRET=generated-by-bootstrap
DATABASE_URL=postgresql://think_meet_app:generated@postgre-container-db-1:5432/think_meet?schema=public
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=think_meet_app
S3_SECRET_KEY=generated-by-bootstrap
S3_BUCKET=think-meet
COOKIE_SECURE=true
SEED_PASSWORD=test123
# Optional JSON rollout overrides. Unknown IDs, nonboolean values and unfinished features fail startup.
# THINK_MEET_FEATURE_FLAGS={"meeting.pip":false}
