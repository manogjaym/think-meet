generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(uuid()) @db.Uuid
  username String @unique
  name String
  role UserRole
  passwordHash String
  createdAt DateTime @default(now())
  sessions LoginSession[]
  teacherLinks TeacherStudent[] @relation("teacher")
  studentLinks TeacherStudent[] @relation("student")
  attendanceOverrides StudentAttendanceOverride[]
  subjects TeacherSubject[]
  // History references are RESTRICT: there is no user deletion, and records must not be orphaned.
  taughtLessons Lesson[] @relation("LessonTeacher")
  lessonMemberships LessonMember[]
  attendance Attendance[]
  messages Message[]
  materials Material[]
  strokes Stroke[]
  annotationOperations AnnotationOperation[]
  authoredNoteImages ClassNoteImage[] @relation("ClassNoteAuthor")
  studentNoteImages ClassNoteImage[] @relation("ClassNoteStudent")
  lessonRecordings LessonRecording[]
}
enum UserRole {
  teacher
  student
}
enum LessonStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}
enum LessonAccessMode {
  INVITE_ONLY
  OPEN
}
enum MaterialKind {
  media
  document
}
enum StrokeTool {
  pen
  highlighter
}
enum ClassNoteImageKind {
  worksheet
  capture
  correction
}
model LoginSession {
  id String @id
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}
model TeacherStudent {
  teacherId String @db.Uuid
  studentId String @db.Uuid
  teacher User @relation("teacher", fields: [teacherId], references: [id], onDelete: Cascade)
  student User @relation("student", fields: [studentId], references: [id], onDelete: Cascade)
  @@id([teacherId, studentId])
}
model TeacherSubject {
  id String @id @default(uuid()) @db.Uuid
  teacherId String @db.Uuid
  teacher User @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  name String
  lessons Lesson[]
  materials Material[]
  noteImages ClassNoteImage[]
  @@unique([teacherId, name])
}

enum LessonInstructionPhase {
  preparing
  classroom
  mirroring
}
model Lesson {
  id String @id @default(uuid()) @db.Uuid
  teacherId String @db.Uuid
  teacher User @relation("LessonTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  subjectId String? @db.Uuid
  subject TeacherSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  title String
  description String @default("")
  accessMode LessonAccessMode @default(INVITE_ONLY)
  startsAt DateTime
  endsAt DateTime?
  status LessonStatus @default(SCHEDULED)
  code String @unique
  startedAt DateTime?
  instructionPhase LessonInstructionPhase?
  instructionStartedAt DateTime?
  endedAt DateTime?
  /// classroom.subject-switch: the live lesson that replaced this one when the teacher changed the subject.
  nextLessonId String? @unique @db.Uuid
  nextLesson Lesson? @relation("LessonSubjectSwitch", fields: [nextLessonId], references: [id], onDelete: SetNull)
  previousLesson Lesson? @relation("LessonSubjectSwitch")
  roomName String @unique
  seq Int @default(0)
  share Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members LessonMember[]
  messages Message[]
  strokes Stroke[]
  attendance Attendance[]
  attendanceOverrides StudentAttendanceOverride[]
  noteImages ClassNoteImage[]
  recordings LessonRecording[]
  annotationOperations AnnotationOperation[]
  @@index([teacherId, startsAt])
  @@index([subjectId])
  @@index([accessMode, status, startsAt])
}
model LessonMember {
  lessonId String @db.Uuid
  userId String @db.Uuid
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  banned Boolean @default(false)
  raised Boolean @default(false)
  annotationAllowed Boolean @default(false)
  admissionId String?
  online Boolean @default(false)
  disconnectedAt DateTime?
  prejoinWaits PrejoinWait[]
  @@id([lessonId, userId])
  @@index([userId])
}
model PrejoinWait {
  lessonId String @db.Uuid
  userId String @db.Uuid
  clientId String @db.Uuid
  expiresAt DateTime
  member LessonMember @relation(fields: [lessonId, userId], references: [lessonId, userId], onDelete: Cascade)
  @@id([lessonId, userId, clientId])
  @@index([expiresAt])
}
model Attendance {
  id String @id @default(uuid()) @db.Uuid
  lessonId String @db.Uuid
  userId String @db.Uuid
  admissionId String
  livekitSid String? @unique
  joinedAt DateTime @default(now())
  leftAt DateTime?
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([lessonId, userId])
}
enum StudentAttendanceStatus {
  PRESENT
  LATE
  ABSENT
}
enum StudentAttendanceReason {
  DEVICE
  NETWORK
  OTHER
}
model StudentAttendanceOverride {
  lessonId String @db.Uuid
  studentId String @db.Uuid
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status StudentAttendanceStatus
  reason StudentAttendanceReason?
  memo String? @db.VarChar(500)
  @@id([lessonId, studentId])
  @@index([studentId])
}
model Message {
  id String @id @default(uuid()) @db.Uuid
  lessonId String @db.Uuid
  userId String @db.Uuid
  userName String
  clientId String
  text String
  createdAt DateTime @default(now())
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([lessonId, userId, clientId])
  @@index([lessonId, createdAt])
}
model Material {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  /// Subject the material is stored under; null for unclassified (pre-subject) uploads.
  subjectId String? @db.Uuid
  subject TeacherSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  name String
  kind MaterialKind
  objectKey String @unique
  size Int
  contentType String
  duration Float?
  pages Int?
  createdAt DateTime @default(now())
  @@index([ownerId, subjectId])
}
model Stroke {
  id String @id
  lessonId String @db.Uuid
  authorId String @db.Uuid
  shareId String
  page Int @default(1)
  tool StrokeTool
  color String
  points Json
  deleted Boolean @default(false)
  revision Int @default(0)
  createdAt DateTime @default(now())
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  @@index([lessonId, shareId, page])
}
model WebhookEvent {
  id String @id
  createdAt DateTime @default(now())
}
model AnnotationOperation {
  id String @id @default(uuid()) @db.Uuid
  lessonId String @db.Uuid
  actorId String @db.Uuid
  shareId String
  page Int
  patches Json
  undone Boolean @default(false)
  createdAt DateTime @default(now())
  touchedAt DateTime @updatedAt
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([lessonId, actorId, shareId, page, undone])
}

model ClassNoteImage {
  id String @id @default(uuid()) @db.Uuid
  lessonId String @db.Uuid
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  authorId String @db.Uuid
  author User @relation("ClassNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  studentId String? @db.Uuid
  student User? @relation("ClassNoteStudent", fields: [studentId], references: [id], onDelete: Restrict)
  /// Subject the image is stored under; follows the lesson's subject, null when unclassified.
  subjectId String? @db.Uuid
  subject TeacherSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  kind ClassNoteImageKind
  requestId String @db.Uuid
  originalId String? @unique @db.Uuid
  original ClassNoteImage? @relation("ClassNoteCorrection", fields: [originalId], references: [id], onDelete: Cascade)
  correction ClassNoteImage? @relation("ClassNoteCorrection")
  objectKey String @unique
  contentType String
  size Int
  createdAt DateTime @default(now())
  @@unique([authorId, requestId])
  @@index([studentId, kind, createdAt])
  @@index([lessonId, kind, createdAt])
  @@index([subjectId])
}

/// A teacher app's screen recording, uploaded in fixed-size chunks through an S3 multipart upload and kept for 30 days.
model LessonRecording {
  id String @id @default(uuid()) @db.Uuid
  lessonId String @db.Uuid
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  teacherId String @db.Uuid
  teacher User @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  requestId String @db.Uuid
  objectKey String @unique
  /// S3 multipart upload ID while uploading; null once completed.
  uploadId String?
  /// Completed parts as [{ PartNumber, ETag }].
  parts Json @default("[]")
  status String @default("uploading")
  size BigInt
  uploadedBytes BigInt @default(0)
  durationMs Int
  width Int
  height Int
  startedAt DateTime
  createdAt DateTime @default(now())
  completedAt DateTime?
  expiresAt DateTime
  @@unique([teacherId, requestId])
  @@index([teacherId, expiresAt])
  @@index([lessonId])
  @@index([expiresAt])
}
