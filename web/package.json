{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "design:generate": "node ../design/scripts/generate.mjs",
    "design:check": "node ../design/scripts/generate.mjs --check",
    "contracts:generate": "node ../contracts/scripts/generate.mjs",
    "contracts:check": "node ../contracts/scripts/generate.mjs --check",
    "test:features": "node --experimental-strip-types --test test/features.test.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.25",
    "livekit-client": "^2.23.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.5",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
